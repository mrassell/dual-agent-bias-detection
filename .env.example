# Copy to .env and fill in (or export in shell). No model IDs belong in source code.

# BASIL corpus
# BASIL_DATA_DIR=/path/to/emnlp19-BASIL/data

# RoBERTa / HF sentence auditor (required for detect_bias, evaluate_basil, sweeps, full eval)
# AUDITOR_MODEL_ID=mediabiasgroup/roberta-babe-ft

# NLI sequence-classification checkpoint (required for nli_check, full eval verifier)
# NLI_MODEL_NAME=facebook/bart-large-mnli

# SQLite audit DB
# MCP_AUDIT_DB=bias_mcp_audit.db

# --- Cloud LLM slots (multi-provider & llm_bias_score / llm_verify tools) ---
# Slot A (example: OpenAI)
# BIAS_LLM_A_VENDOR=openai
# BIAS_LLM_A_MODEL=gpt-4o-mini
# OPENAI_API_KEY=sk-...

# Slot B (example: Anthropic)
# BIAS_LLM_B_VENDOR=anthropic
# BIAS_LLM_B_MODEL=claude-haiku-4-5-20251001
# ANTHROPIC_API_KEY=sk-ant-...

# Optional: OpenAI-compatible (Groq, Together, OpenRouter, Azure proxy)
# BIAS_LLM_A_VENDOR=openai_compatible
# BIAS_LLM_A_MODEL=llama-3.1-8b-instant
# BIAS_LLM_A_OPENAI_BASE_URL=https://api.groq.com/openai/v1
# BIAS_LLM_A_API_KEY=...

# Multi-provider script slot ids (default A and B)
# MULTI_PROVIDER_SLOT_A=A
# MULTI_PROVIDER_SLOT_B=B

# LLM pipeline script (scripts/run_llm_pipeline.py)
# BIAS_LLM_AUDITOR_SLOT=A
# BIAS_LLM_VERIFIER_SLOT=B

# Override packaged prompts (optional)
# BIAS_LLM_PROMPT_SCORING_FILE=/path/to/prompt.txt
# BIAS_LLM_PROMPT_VERIFIER_FILE=/path/to/verifier_prompt.txt
